[TITLE]
DrainageDoctor deterministic benchmark - synthetic inflow network

[OPTIONS]
FLOW_UNITS CMS
INFILTRATION HORTON
FLOW_ROUTING DYNWAVE
START_DATE 01/01/2026
START_TIME 00:00:00
REPORT_START_DATE 01/01/2026
REPORT_START_TIME 00:00:00
END_DATE 01/01/2026
END_TIME 03:00:00
REPORT_STEP 00:01:00
WET_STEP 00:01:00
DRY_STEP 00:01:00
ROUTING_STEP 00:00:05
ALLOW_PONDING YES

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1 10 1.5 0 0 100
J2 9 1.5 0 0 100

[OUTFALLS]
O1 8 FREE NO

[CONDUITS]
;;Name From To Length Roughness InOffset OutOffset InitFlow MaxFlow
C1 J1 J2 100 0.013 0 0 0 0
C2 J2 O1 100 0.013 0 0 0 0

[XSECTIONS]
C1 CIRCULAR 0.30 0 0 0 1
C2 CIRCULAR 0.30 0 0 0 1

[INFLOWS]
J1 FLOW INFLOW FLOW 1.0 1.0 0

