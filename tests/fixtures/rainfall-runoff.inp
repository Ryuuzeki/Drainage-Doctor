[TITLE]
DrainageDoctor rainfall-runoff golden fixture

[OPTIONS]
FLOW_UNITS CMS
INFILTRATION HORTON
FLOW_ROUTING DYNWAVE
START_DATE 01/01/2026
START_TIME 00:00:00
REPORT_START_DATE 01/01/2026
REPORT_START_TIME 00:00:00
END_DATE 01/01/2026
END_TIME 03:00:00
REPORT_STEP 00:05:00
WET_STEP 00:01:00
DRY_STEP 00:01:00
ROUTING_STEP 00:00:05
ALLOW_PONDING YES

[RAINGAGES]
;;Name Format Interval SCF Source Data
G1 INTENSITY 00:05 1.0 TIMESERIES RAIN

[SUBCATCHMENTS]
;;Name RainGage Outlet Area %Imperv Width %Slope CurbLen SnowPack
S1 G1 J1 10.0 80 200 2.0 0

[SUBAREAS]
;;Subcatchment N-Imperv N-Perv S-Imperv S-Perv PctZero Route PctRouted
S1 0.013 0.2 0 5 25 OUTLET 0

[INFILTRATION]
;;Subcatchment MaxRate MinRate Decay DryTime MaxInfil
S1 50 5 0.001 4 0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1 10 0.3 0 0 100

[OUTFALLS]
O1 8 FREE NO

[CONDUITS]
;;Name From To Length Roughness InOffset OutOffset InitFlow MaxFlow
C1 J1 O1 100 0.013 0 0 0 0

[XSECTIONS]
C1 CIRCULAR 0.10 0 0 0 1

[TIMESERIES]
RAIN 01/01/2026 00:00 0.0
RAIN 01/01/2026 00:15 10.0
RAIN 01/01/2026 00:30 20.0
RAIN 01/01/2026 01:00 5.0
RAIN 01/01/2026 01:30 0.0
RAIN 01/01/2026 03:00 0.0

[REPORT]
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[COORDINATES]
J1 100 100
O1 450 200
